# Normalise line endings across Windows / macOS / Linux checkouts.
# Text files are stored as LF in the repository and checked out as LF.
* text=auto eol=lf

# Windows-only scripts keep CRLF so cmd/PowerShell handle them natively.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never touch.
*.docx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
