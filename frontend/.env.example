# Local dev ONLY. This file (frontend/.env) is gitignored.
#
# Production builds ignore .env (see vite.config.js: `envDir` is disabled in
# production mode), because the frontend is always served same-origin by the
# FastAPI app — so `VITE_API_BASE_URL` must resolve to "" in production.
#
# Copy to frontend/.env only if you need the dev server to talk to a backend
# on a non-default port:
#
#   VITE_API_BASE_URL=http://localhost:8001
#
# Leave it unset (or empty) to use the Vite dev proxy / same-origin requests.
VITE_API_BASE_URL=
