# ---- Supabase (Postgres + Auth + RLS) --------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Direct Postgres connection — used only by scripts (verify_schema, migrations).
POSTGRES_DSN=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# ---- LLM providers ---------------------------------------------------------
GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=
COHERE_API_KEY=

# ---- Embeddings ------------------------------------------------------------
# The embedding dimension MUST match documents.embedding / draft_clauses.embedding
# (768). Changing the embedder/model means re-embedding the whole corpus and
# draft_clauses (scripts/reembed_all.py) — see docs/operations/migrations-and-rollbacks.md.
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
# Hosted embedder (recommended: keeps torch out of the process, so the app runs
# on a small VM / the Docker image, which installs requirements.txt only). When
# set, BOTH ingest and query use it. Gemini:
REMOTE_EMBED_URL=https://generativelanguage.googleapis.com/v1beta/openai/
REMOTE_EMBED_KEY=your-gemini-api-key
REMOTE_EMBED_MODEL=gemini-embedding-001

# ---- Google Drive ingest ---------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
DRIVE_FOLDER_ID=your-google-drive-folder-id
DRIVE_WEBHOOK_SECRET=choose-a-long-random-channel-token
# Required by the worker's POST /ingest/manual (fails closed if unset).
INGEST_WORKER_TOKEN=choose-a-long-random-operator-token

# ---- Retrieval / chunking --------------------------------------------------
CHAT_MODEL=openai/gpt-oss-120b
CHAT_MAX_TOKENS=4096
CHUNK_SIZE=900
CHUNK_OVERLAP=80
RETRIEVE_TOP_K=20
CONTEXT_WINDOW=10
USE_EMBED_PREFIXES=false
USE_AGENTIC_CHUNKING=false

DEFAULT_INGEST_ACCESS_LEVEL=1
DEFAULT_INGEST_MATTER_ID=

# ---- Optional tracing ------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=newFirmRAG

# ---- Runtime ---------------------------------------------------------------
# Environment: development | production
# In production, CORS_ORIGINS must be an explicit allow-list (no "*"), and
# SUPABASE_JWT_SECRET must be set (unverified tokens are refused).
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
LOG_LEVEL=INFO
