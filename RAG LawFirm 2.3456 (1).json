    {
      "parameters": {
        "jsCode": "// orphan finder: documents in Supabase vector store without corresponding Drive file\nconst driveIds = new Set($('Get File IDs').all().map(i => i.json.id));\nconst supabaseRows = $('Supabase getAll documents').all();\nconst orphans = supabaseRows.filter(row => {\n  const fileId = row.json.metadata && row.json.metadata.file_id;\n  return fileId && !driveIds.has(fileId);\n});\nreturn orphans.map(row => ({ json: { id: row.json.id, file_id: row.json.metadata.file_id } }));"
      },
