    {
      "parameters": {
        "jsCode": "const creds = await this.getCredentials('supabaseApi');\nconst SERVICE_KEY = creds.serviceRole;\n\nconst item = $input.first().json;\nconst rls  = item._rls_filter || {};\nconst rbac = item._rbac || {};\nconst ctx  = item._user_ctx || {};\n\nconst SUPABASE_URL = creds.host;\n\ntry {\n  await this.helpers.httpRequest({\n    method: 'POST',\n    url: `${SUPABASE_URL}/rest/v1/rpc/set_access_context`,\n    headers: {\n      'apikey':        SERVICE_KEY,\n      'Authorization': `Bearer ${SERVICE_KEY}`,\n      'Content-Type':  'application/json'\n    },\n    body: JSON.stringify({\n      p_access_level: rls.max_access_level ?? 1,\n      p_matter_ids:   rls.matter_filter   ?? [],\n      p_view_all:     rbac.perms          ? rbac.perms.view_all : false,\n      p_user_id:      ctx.user_id         ?? null,\n      p_role:         ctx.role            ?? 'associate'\n    })\n  });\n} catch(e) {\n  console.log('set_access_context warning:', e.message);\n}\n\nreturn [$input.first()];"
      },
