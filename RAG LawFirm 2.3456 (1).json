      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst ctx  = item._user_ctx;\nconst rbac = item._rbac;\nconst rlsFilter = {\n  max_access_level: rbac.perms.level,\n  matter_filter:    rbac.perms.view_all ? null : ctx.matter_ids\n};\nconst chatInput = item.chatInput || item.input || item.query || item.message || '';\nreturn [{\n  json: {\n    ...item,\n    _rls_filter: rlsFilter,\n    chatInput,\n    _query_text: chatInput\n  }\n}];"
      },
