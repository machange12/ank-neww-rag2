    {
      "parameters": {
        "jsCode": "// Simple code to handle empty Google Drive\nlet hasDriveData = false;\nlet driveFileIds = new Set();\n\nif (items[0] && items[0].json) {\n  if (items[0].json.files && Array.isArray(items[0].json.files)) {\n    hasDriveData = true;\n    for (const file of items[0].json.files) {\n      if (file && file.id) driveFileIds.add(file.id);\n    }\n  } else if (items[0].json.id && !items[0].json.title && !items[0].json.created_at) {\n    hasDriveData = true;\n    driveFileIds.add(items[0].json.id);\n  }\n}\n\nlet metadataRecords = hasDriveData\n  ? items.slice(1).map(i => i.json).filter(Boolean)\n  : items.map(i => i.json).filter(Boolean);\n\nconst recordsToDelete = driveFileIds.size === 0\n  ? metadataRecords.filter(r => r && r.id).map(r => ({ ...r, _shouldDelete: true }))\n  : metadataRecords.filter(r => r && r.id && !driveFileIds.has(r.id)).map(r => ({ ...r, _shouldDelete: true }));\n\nconsole.log(`Orphaned metadata records to delete: ${recordsToDelete.length}`);\nreturn recordsToDelete;"
      },
